<!DOCTYPE html>
<html>
<head>
    <title>Session Tracking</title>

    <style>
        body {
            font-family: Arial;
            background: #f2f2f2;
            text-align: center;
            padding-top: 100px;
        }

        .box {
            background: white;
            width: 400px;
            margin: auto;
            padding: 30px;
            border-radius: 10px;
        }

        input {
            padding: 10px;
            width: 250px;
        }

        button {
            padding: 10px 25px;
            margin-top: 15px;
        }
    </style>
</head>

<body>

<div class="box">

    <h2>Session Tracking</h2>

    <form action="Servlet1" method="post">

        <input type="text"
               name="username"
               placeholder="Enter your name"
               required>

        <br>

        <button type="submit">Continue</button>

    </form>

</div>

</body>
</html>
